# 隐患识别平台环境变量配置

# 服务器配置
PORT=3000
MOCK_API_PORT=3001
NODE_ENV=development

# AI服务API配置（用于接入真实AI能力）
# 目标检测API
OBJECT_DETECTION_API_URL=https://api.example.com/detect
OBJECT_DETECTION_API_KEY=your_api_key_here

# 场景识别API
SCENE_RECOGNITION_API_URL=https://api.example.com/recognize
SCENE_RECOGNITION_API_KEY=your_api_key_here

# 二维码解析API
QR_CODE_API_URL=https://api.example.com/parse
QR_CODE_API_KEY=your_api_key_here

# 距离测量API
DISTANCE_MEASUREMENT_API_URL=https://api.example.com/measure
DISTANCE_MEASUREMENT_API_KEY=your_api_key_here

# 状态识别API
STATUS_DETECTION_API_URL=https://api.example.com/status
STATUS_DETECTION_API_KEY=your_api_key_here

# 超时设置（毫秒）
API_TIMEOUT=30000
UPLOAD_TIMEOUT=60000

# 文件上传配置
MAX_FILE_SIZE=10MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# 调试配置
DEBUG_MODE=true
LOG_LEVEL=info

# 安全配置
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100